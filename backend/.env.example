# AETHER PITCH — Azure environment configuration (all OPTIONAL)
# Copy to `.env` and fill in to route Stage (c)/(e) through real Azure;
# Stage (d) Web PubSub is reserved and not wired.
# services. Without any of these, the studio runs fully offline on
# deterministic local fallbacks (judge-ready out of the box).

# ---- Stage (c): Azure AI Foundry / Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_TRIAGE_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_NARRATIVE_DEPLOYMENT=gpt-4o

# ---- Stage (d): Azure Web PubSub (reserved; local WebSocket is default) ----
AZURE_WEBPUBSUB_CONNECTION_STRING=
AZURE_WEBPUBSUB_HUB=aether

# ---- Stage (e): Azure Translator ----
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=global

# ---- Optional second RAI layer: Azure AI Content Safety ----
# The deterministic Prompt Shield always runs. Point these at an Azure AI
# Content Safety account to add the real cloud safety service on top.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ---- Simulation knobs ----
MATCH_TIME_SCALE=6.0
MATCH_START_MINUTE=62.0
AETHER_SEED=42
