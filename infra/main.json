{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "AETHER PITCH — Azure-native deployment: Azure AI Foundry (AI Services) model deployments, Azure AI Translator, Key Vault with managed identity, Azure Container Apps (engine + studio), Application Insights and Azure Monitor alerts.",
    "author": "AETHER PITCH"
  },
  "parameters": {
    "prefix": {
      "type": "string",
      "defaultValue": "aether",
      "minLength": 3,
      "maxLength": 16,
      "metadata": { "description": "Resource name prefix (lowercase alphanumeric)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Deployment region." }
    },
    "foundryModelTriage": {
      "type": "string",
      "defaultValue": "gpt-4o-mini",
      "metadata": { "description": "Fast triage deployment for the 4-node handoff router." }
    },
    "foundryModelTriageVersion": {
      "type": "string",
      "defaultValue": "2024-07-18"
    },
    "foundryModelNarrative": {
      "type": "string",
      "defaultValue": "gpt-4o",
      "metadata": { "description": "Narrative / war-room deployment." }
    },
    "foundryModelNarrativeVersion": {
      "type": "string",
      "defaultValue": "2024-11-20"
    },
    "foundryCapacityTriage": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1
    },
    "foundryCapacityNarrative": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1
    },
    "openAiApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Azure AI Foundry key. Leave empty to deploy in deterministic offline mode." }
    },
    "translatorKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Azure AI Translator key. Leave empty to use the local phrase atlas." }
    },
    "deployContentSafety": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Provision Azure AI Content Safety as the optional second RAI layer." }
    },
    "contentSafetyKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Azure AI Content Safety key. Leave empty to keep the deterministic Prompt Shield as the only layer." }
    },
    "engineImage": {
      "type": "string",
      "defaultValue": "ghcr.io/shashankh3/aether-engine:latest",
      "metadata": { "description": "Container image for the FastAPI engine." }
    },
    "studioImage": {
      "type": "string",
      "defaultValue": "ghcr.io/shashankh3/aether-studio:latest",
      "metadata": { "description": "Container image for the Next.js studio." }
    },
    "engineMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1
    },
    "engineMaxReplicas": {
      "type": "int",
      "defaultValue": 4,
      "minValue": 1
    }
  },
  "variables": {
    "foundryName": "[concat(parameters('prefix'), '-foundry')]",
    "translatorName": "[concat(parameters('prefix'), '-translator')]",
    "contentSafetyName": "[concat(parameters('prefix'), '-safety')]",
    "keyVaultName": "[concat(parameters('prefix'), '-kv')]",
    "identityName": "[concat(parameters('prefix'), '-engine-id')]",
    "envName": "[concat(parameters('prefix'), '-env')]",
    "engineName": "[concat(parameters('prefix'), '-engine')]",
    "studioName": "[concat(parameters('prefix'), '-studio')]",
    "logAnalyticsName": "[concat(parameters('prefix'), '-logs')]",
    "appInsightsName": "[concat(parameters('prefix'), '-ai')]",
    "foundryEndpoint": "[concat('https://', variables('foundryName'), '.openai.azure.com')]",
    "translatorEndpoint": "[concat('https://', variables('translatorName'), '.cognitiveservices.azure.com')]",
    "engineIdentityPrincipalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "cognitiveServicesUserRoleId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": 30,
        "features": { "enableLogAccessUsingOnlyResourcePermissions": true }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": { "azd-service-name": "engine" },
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "IngestionMode": "LogAnalytics"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('foundryName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "sku": { "name": "S0" },
      "properties": {
        "customSubDomainName": "[variables('foundryName')]",
        "publicNetworkAccess": "Enabled",
        "restore": false
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('foundryName'), '/', parameters('foundryModelTriage'))]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "capacity": "[parameters('foundryCapacityTriage')]" },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('foundryModelTriage')]",
          "version": "[parameters('foundryModelTriageVersion')]"
        },
        "properties": {}
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('foundryName'), '/', parameters('foundryModelNarrative'))]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard", "capacity": "[parameters('foundryCapacityNarrative')]" },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('foundryModelNarrative')]",
          "version": "[parameters('foundryModelNarrativeVersion')]"
        },
        "properties": {}
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('translatorName')]",
      "location": "[parameters('location')]",
      "kind": "TextTranslation",
      "sku": { "name": "F0" },
      "properties": {
        "customSubDomainName": "[variables('translatorName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('contentSafetyName')]",
      "location": "[parameters('location')]",
      "kind": "ContentSafety",
      "sku": { "name": "F0" },
      "properties": {
        "customSubDomainName": "[variables('contentSafetyName')]",
        "publicNetworkAccess": "Enabled"
      },
      "condition": "[parameters('deployContentSafety')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": { "azd-service-name": "engine" },
      "properties": {
        "sku": { "family": "A", "name": "standard" },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('engineIdentityPrincipalId'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
        "principalId": "[variables('engineIdentityPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('engineIdentityPrincipalId'), variables('cognitiveServicesUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRoleId'))]",
        "principalId": "[variables('engineIdentityPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "tags": { "azd-env-name": "aether-pitch" },
      "properties": {
        "zoneRedundant": false,
        "infrastructure": { "containerApps": { "resourceGroupName": "[resourceGroup().name]" } }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[variables('engineName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
        }
      },
      "tags": { "azd-service-name": "engine" },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "azure-openai-api-key",
              "value": "[parameters('openAiApiKey')]"
            },
            {
              "name": "azure-translator-key",
              "value": "[parameters('translatorKey')]"
            },
            {
              "name": "azure-content-safety-key",
              "value": "[parameters('contentSafetyKey')]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              { "latestRevision": true, "weight": 100 }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "engine",
              "image": "[parameters('engineImage')]",
              "resources": { "cpu": 1.0, "memory": "2Gi" },
              "env": [
                { "name": "MATCH_TIME_SCALE", "value": "6.0" },
                { "name": "MATCH_START_MINUTE", "value": "62.0" },
                { "name": "AETHER_SEED", "value": "42" },
                { "name": "AZURE_OPENAI_ENDPOINT", "value": "[variables('foundryEndpoint')]" },
                { "name": "AZURE_OPENAI_API_KEY", "secretRef": "azure-openai-api-key" },
                { "name": "AZURE_OPENAI_API_VERSION", "value": "2024-06-01" },
                { "name": "AZURE_OPENAI_TRIAGE_DEPLOYMENT", "value": "[parameters('foundryModelTriage')]" },
                { "name": "AZURE_OPENAI_NARRATIVE_DEPLOYMENT", "value": "[parameters('foundryModelNarrative')]" },
                { "name": "AZURE_TRANSLATOR_ENDPOINT", "value": "[variables('translatorEndpoint')]" },
                { "name": "AZURE_TRANSLATOR_KEY", "secretRef": "azure-translator-key" },
                { "name": "AZURE_TRANSLATOR_REGION", "value": "global" },
                {
                  "name": "AZURE_CONTENT_SAFETY_ENDPOINT",
                  "value": "[if(parameters('deployContentSafety'), concat('https://', variables('contentSafetyName'), '.cognitiveservices.azure.com'), '')]"
                },
                { "name": "AZURE_CONTENT_SAFETY_KEY", "secretRef": "azure-content-safety-key" },
                { "name": "APPLICATIONINSIGHTS_CONNECTION_STRING", "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]" }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": { "path": "/api/health", "port": 8000 },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 20,
                  "timeoutSeconds": 3,
                  "failureThreshold": 3,
                  "successThreshold": 1
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('engineMinReplicas')]",
            "maxReplicas": "[parameters('engineMaxReplicas')]",
            "rules": [
              {
                "name": "http",
                "http": { "concurrentRequests": 50 }
              }
            ]
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[variables('studioName')]",
      "location": "[parameters('location')]",
      "tags": { "azd-service-name": "studio" },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('engineName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              { "latestRevision": true, "weight": 100 }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "studio",
              "image": "[parameters('studioImage')]",
              "resources": { "cpu": 1.0, "memory": "2Gi" },
              "env": [
                {
                  "name": "AETHER_API_URL",
                  "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', variables('engineName')), '2023-05-01').properties.configuration.ingress.fqdn)]"
                },
                {
                  "name": "AETHER_WS_URL",
                  "value": "[concat('wss://', reference(resourceId('Microsoft.App/containerApps', variables('engineName')), '2023-05-01').properties.configuration.ingress.fqdn, '/ws')]"
                },
                { "name": "BACKEND_ORIGIN", "value": "[concat('http://', variables('engineName'), ':8000')]" }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": { "path": "/", "port": 3000 },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20,
                  "timeoutSeconds": 3,
                  "failureThreshold": 3,
                  "successThreshold": 1
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http",
                "http": { "concurrentRequests": 40 }
              }
            ]
          }
        }
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2023-04-01",
      "name": "[concat(parameters('prefix'), '-engine-down')]",
      "scope": "[resourceId('Microsoft.App/containerApps', variables('engineName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "description": "AETHER PITCH — the broadcast engine is not serving.",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT1M",
        "window": "PT5M",
        "criteria": {
          "allOf": [
            {
              "metricName": "RestartCount",
              "dimensions": [{ "name": "containerName", "operator": "Include", "values": ["engine"] }],
              "aggregation": "Total",
              "operator": "GreaterThan",
              "threshold": 2
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2023-04-01",
      "name": "[concat(parameters('prefix'), '-engine-latency')]",
      "scope": "[resourceId('Microsoft.App/containerApps', variables('engineName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "description": "AETHER PITCH — engine request latency is above the broadcast budget.",
        "severity": 3,
        "enabled": true,
        "evaluationFrequency": "PT1M",
        "window": "PT5M",
        "criteria": {
          "allOf": [
            {
              "metricName": "RequestDuration",
              "dimensions": [{ "name": "containerName", "operator": "Include", "values": ["engine"] }],
              "aggregation": "Average",
              "operator": "GreaterThan",
              "threshold": 1000
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "studioUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', variables('studioName')), '2023-05-01').properties.configuration.ingress.fqdn)]"
    },
    "engineUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', variables('engineName')), '2023-05-01').properties.configuration.ingress.fqdn)]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[variables('foundryEndpoint')]"
    },
    "translatorEndpoint": {
      "type": "string",
      "value": "[variables('translatorEndpoint')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    }
  }
}
