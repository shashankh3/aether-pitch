{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "deny",
    "task": { "*": "allow" },
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/AppData/Local/Temp/opencode/**": "allow",
      "~/Library/Caches/opencode/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow"
    },
    "shell": {
      "*": "allow",
      "git push*main*": "deny",
      "git push*master*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout main*": "deny",
      "git checkout master*": "deny",
      "git switch main*": "deny",
      "git switch master*": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git branch -D*": "deny",
      "git commit --amend*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf *": "deny",
      "Remove-Item *-Recurse*": "deny",
      "format *": "deny",
      "curl *": "allow",
      "Invoke-WebRequest *": "allow"
    }
  }
}
